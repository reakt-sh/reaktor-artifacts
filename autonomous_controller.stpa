Losses
L1 "Loss of life or injury"
L2 "Loss of operating components, vehicle or infrastructure"
L3 "Loss of Communication"
L4 "Loss of mission"
L5 "Loss of customer satisfaction"

Hazards
H1 "System integrity is lost" [L1,L2,L3,L4,L5]

H2 "Vehicle exceeds safe-operating envelope for its environment (Speed, Lateral/Horizontal forces)" [L1,L2]{

    H2.1 "Vehicle exceeds safe speed limit of the track"
    H2.2 "Vehicle accelerates too fast"
    H2.3 "Vehicle decelerates too fast, while not performing a Emergency Stop"
}

H3 "Vehicle comes too close to objects on track" [L1,L2]

H4 "Vehicle loses communication to infrastructure or other vehicles" [L3,L4]

H5 "Vehicle loses connection while being controlled by remote controller" [L1,L2,L3,L4]

H6 "Insufficient positional awareness of the vehicle on the track" [L1,L2,L4]



SystemConstraints
SC1 "System integrity must not be lost" [H1]

SC2 "Vehicle may not exceed the safe-operating envelope for its environment" [H2]{

    SC2.1 "Vehicle may not exceed the safe speed limit of the track" [H2.1]
    SC2.2 "Vehicle may not accelerate too fast" [H2.2]
    SC2.3 "Vehicle my not deccelerate too fast, while not performing a Emergency Stop" [H2.3]
}

SC3 "Vehicle must remain a safe distance to objects on the track" [H3]

SC4 "Vehicle must not lose communication to infrastructure or other vehicles" [H4]

SC5 "Vehicle must not lose connection while being controlled by the remote controller"[H5]

SC6 "Vehicle must at all times have a sufficient awareness of its own position" [H6]



ControlStructure
Structure{
    // Controller able to overtake control of the train remotly
    RemoteController{
        processModel{
            gpsPosition: [GPS]
            currentSpeed: [trainSpeed]
            driveControllerMode: [emergencyStop=[1], forwards=[2], backwards=[3]]
        }
        controlActions{
            [takeControl "takeControl", releaseControl "releaseControl", setSpeed "setSpeed", setMode "setMode"] -> OperatingController
        }

    }
    // Control structure resposable for the management of the trains
    ManagementSystem{
        processModel{
            safeDockingNeeded: [Yes = [true], No = [false]]
            trainJobListEmpty: [Yes = [true], No = [false]]
            availableJobs: [Yes = [true], No = [false]]
        }
        controlActions{
            [setDestination "setDestination", deleteDestination "deleteDestination", safeDocking "safeDocking"] -> OperatingController
        }
    }

    // Physical Train and all it's components
    Train{
        OperatingController{
            processModel{
                //weather_conditions: [good, medium, bad]
                remote_control: [on=[true],off=[false]]
                mode: [initialization=[0],normal=[1], degraded = [2],emergency= [4]]
                safeDocking: [on = [true], off = [false]]
                driveControllerMode: [emergencyStop=[1], forwards=[2], backwards=[3]]
                gpsPosition: [GPS]
                trackPosition: [trackkilometer]
                desiredSpeed: [zero = [0], greaterZero = (0,MAX]]
                driveDirection: [forwards=[2], backwards=[3]]
                currentSpeed: [trainSpeed=[desiredSpeed], lessDesiredSpeed = [MIN, desiredSpeed), greaterDesiredSpeed=(desiredSpeed, MAX]]
                destinationList: [destination]
                distanceToDestination: [smallerOneKM = (MIN,1], greaterOneKM = [1, MAX]]
                distanceToVehicle: [greater500m = (500,MAX],  smaller500m = (10,500], smaller10m = [MIN,10]]

                
            }
            controlActions{
                //  [setMode "setMode", setSpeed "setSpeed", setDirection "setDirection"] -> DriveController
                // set Speed
               [setSpeed "setSpeed"] -> DriveController
               // set Mode
               [emergencyStop "emergencyStop", forwards "forwards", backwards "backwards"] -> DriveController
               [sendMessage "sendMessage"] -> Communication
               [getDesiredSpeed "getDesiredSpeed", getTrackposition "getTrackPosition"] -> TrackNavigation
               [OtherCA "OtherControlActions"] -> OtherSubSystems

            }
            feedback{
                [TrainSpeed "trainspeed", remoteConf "remoteConfirmation", driveMode "driveMode", camera "camera"] -> RemoteController
                [location2 "gpsLocation", TrainSpeed2 "trainspeed", destConf "destinationConfirmation", safeDockingConf "safeDockingConfirmation", safedockingAbort "abortSafeDocking"] -> ManagementSystem
            }
        }
        DriveController{
            processModel{
                currentSpeed: [desiredSpeed=[setSpeed], lessDesiredSpeed = [MIN, setSpeed), greaterDesiredSpeed=(setSpeed, MAX], greaterZero = (0, MAX], zero = [0]]
                driving_mode: [emergencyStop=[0], forwards=[1], backwards=[2]]

            }
             controlActions{
                [acc "accelerate", dec "decelerate", forwards "forwards", backwards "backwards"]-> Motor
                [brake "brake"] -> WheelBrakes
            }
            feedback{
                [driving_mode "currentMode", desiredSpeed "desiredSpeed", direction "direction"] -> OperatingController
            }
        }
        TrackNavigation{
            processModel{
                gpsPosition: [GPS]
                Track: [Trackkilometers, speedlimit]
                Destination:[Destination]
            }
            feedback{
            [driveDirection "Direction", trackPosition "trackPosition", desiredSpeed "desiredSpeed"] -> OperatingController
            }
        }
        OtherSubSystems{
            feedback{
                [Otherfeedback "Otherfeedback"] -> OperatingController
            }

        }
        PhysicalUnits{

            Motor{
                feedback{
                    [TrainSpeed1 "trainSpeed"] -> OperatingController 
                    [TrainSpeed2 "trainSpeed"] ->DriveController
                }

            }

            WheelBrakes{
                feedback{
                    [trainSpeed "trainSpeed"] -> DriveController
                }

            }

            GPS{
                feedback{
                    [position "gpsPosition"] -> OperatingController
                }
            }

            Sensors{
                feedback{
                    [sensorSignal "sensorSignal", distanceToVehicle "distanceToVehicle"] -> OperatingController
                }

            }
            Communication{
                feedback{
                    [otherVevicleMessage "otherVehicleMessage"] -> OperatingController
                }
            }
        }
        
    }
}

Responsibilities
    OperatingController{
        R1 "Give Control action to reduce speed, if vehicle goes over desired speed, while not being remote controlled"[SC2.1]
        R2 "Give Control action to accelerate to appropiate speed if vehicle is under desired speed and no signals contradict, while not being remote controlled"[SC2]
        R3 "Give Control action for emergency stop if signals demand it, while not being remote controlled"[SC3]
        R4 "Change into degraded mode, if signals spot something near the track, where a full emergency stop is not warranted" [SC3]
        R5 "Must switch into emergency mode in case a system component malfunctions" [SC1]
        R6 "Must switch into remote mode if remote controller wants to take over control" [SC5]
        R7 "If connection to remote controller is unexpected lost, switch  into emergency mode" [SC5]
    }
    DriveController{
        R8 "May not give control action to accelerate too fast" [SC2.2]
        R9 "May not give control action to decelerate or brake too fast, unless it performs an emergency stop" [SC2.3]
        R10 "Set desired speed to 0 in case of emergency Stop" [SC2]
    }
    TrackNavigation{
        R11 "Always give the train the correct positional awareness on the track"[SC6]
    }
    Motor{
        R12 "Decelerate speed, when Drive controller commands it" [SC3]
        R13 "Accelerate  speed, when Drive controller commands it" [SC1]
    }
    WheelBrakes{
        R14 "Brake, when drive controller commands it" [SC3]
    }
    GPS{
        R15 "Must have sufficient awareness over its own position on the track"[SC6]
        R16 "Must regularly give feedback about the change in position to the Operating Controller"[SC6]
    }
    Communication{
        R17 "give imidiate feedback, when communication is unexpectedly interrupted" [SC4]
    }


Context-Table
//Acceleration
RL1{
    controlAction:DriveController.acc
    type: provided
    contexts: {
        UCA1 [driving_mode = emergencyStop] [H1,H3]
        UCA2 [driving_mode = forwards, currentSpeed = desiredSpeed ] [H2.1]
        UCA3 [driving_mode = forwards, currentSpeed = greaterDesiredSpeed ] [H2.1]
        UCA4 [driving_mode = backwards, currentSpeed = desiredSpeed ] [H2.1]
        UCA5 [driving_mode = backwards, currentSpeed = greaterDesiredSpeed ] [H2.1]
    }
}
// Deceleration
RL2{
    controlAction:DriveController.dec
    type: not-provided
    contexts: {
        UCA6 [driving_mode = forwards, currentSpeed = greaterDesiredSpeed] [H2.1]
        UCA7 [driving_mode = backwards, currentSpeed = greaterDesiredSpeed] [H2.1]
    }
}
RL3{
    controlAction:DriveController.dec
    type: too-late
    contexts: {
        UCA8 [driving_mode = forwards, currentSpeed = greaterDesiredSpeed] [H2.1]
        UCA9 [driving_mode = backwards, currentSpeed = greaterDesiredSpeed] [H2.1]
    }
}
RL4{
    controlAction:DriveController.dec
    type: stopped-too-soon
    contexts: {
        UCA10 [driving_mode = forwards, currentSpeed = greaterDesiredSpeed] [H2.1]
        UCA11 [driving_mode = backwards, currentSpeed = greaterDesiredSpeed] [H2.1]
    }
}
// Forwards
RL5{
    controlAction: DriveController.forwards
    type: provided
    contexts:{
        UCA12 [driving_mode = backwards, currentSpeed = greaterZero] [H2]
    }
}
RL6{
    controlAction: DriveController.forwards
    type: not-provided
    contexts:{
        UCA13 [driving_mode = forwards, currentSpeed = zero] [H2]
    }
}
// Backwards
RL7{
    controlAction: DriveController.backwards
    type: provided
    contexts:{
        UCA14 [driving_mode = forwards, currentSpeed = greaterZero] [H2]
    }
}
RL8{
    controlAction: DriveController.backwards
    type: not-provided
    contexts:{
        UCA15 [driving_mode = backwards, currentSpeed = zero] [H2]
    }
}
// Brake
RL9{
    controlAction:DriveController.brake
    type: not-provided
    contexts: { 
        UCA16 [driving_mode = emergencyStop] [H3]
   }
}
RL10{
    controlAction:DriveController.brake
    type: too-late
    contexts: { 
        UCA17 [driving_mode = emergencyStop] [H3]
   }
}
RL11{
    controlAction:DriveController.brake
    type: stopped-too-soon
    contexts: { 
        UCA18 [driving_mode = emergencyStop, currentSpeed = greaterZero] [H3]
   }
}

// SetSpeed
RL12{
    controlAction:OperatingController.setSpeed
    type: not-provided
    contexts: { 
        UCA19 [currentSpeed = greaterDesiredSpeed, mode = normal] [H2.1]
        UCA20 [currentSpeed = greaterDesiredSpeed, mode = degraded] [H2.1]
   }
}

RL13{
    controlAction:OperatingController.setSpeed
    type: provided
    contexts: { 
        UCA21 [mode = emergency, desiredSpeed = zero] [H2.1,H3]
   }
}

RL14{
    controlAction:OperatingController.setSpeed
    type: too-late
    contexts: { 
        UCA22 [currentSpeed = greaterDesiredSpeed, mode = normal] [H2.1]
        UCA23 [currentSpeed = greaterDesiredSpeed, mode = degraded] [H2.1]
   }
}

// SetMode: EmergencyStop
RL15{
    controlAction: OperatingController.emergencyStop
    type: not-provided
    contexts: {
        UCA24 [mode = emergency][H3]
    } 
}
RL16{
    controlAction: OperatingController.emergencyStop
    type: provided
    contexts: {
        UCA25 [mode = normal][H1,H2]
        UCA26 [mode = degraded][H1,H2]
        UCA27 [mode = initialization][H1,H2]

    } 
}
RL17{
    controlAction: OperatingController.emergencyStop
    type: too-late
    contexts: {
         UCA28 [mode = emergency][H3]
    }
}

// SetMode: forwards
RL18{
    controlAction: OperatingController.forwards
    type: provided
    contexts: {
        UCA29 [mode = emergency][H3]
        UCA30 [mode = normal, driveDirection = forwards, driveControllerMode = backwards, currentSpeed = trainSpeed, desiredSpeed = greaterZero][H2]
        UCA31 [mode = degraded, driveDirection = forwards, driveControllerMode = backwards, currentSpeed = trainSpeed, desiredSpeed = greaterZero][H2]   

    } 
}
RL19{
    controlAction: OperatingController.forwards
    type: not-provided
    contexts: {
        UCA32 [mode = normal, driveDirection = forwards, driveControllerMode = backwards, currentSpeed = trainSpeed, desiredSpeed = zero][H2]
        UCA33 [mode = degraded, driveDirection = forwards, driveControllerMode = backwards, currentSpeed = trainSpeed, desiredSpeed = zero][H2]
    } 
}

// SetMode: backwards
RL20{
    controlAction: OperatingController.backwards
    type: provided
    contexts: {
        UCA34 [mode = emergency][H3]
        UCA35 [mode = normal, driveDirection = backwards, driveControllerMode = forwards, currentSpeed = trainSpeed, desiredSpeed = greaterZero][H2]
        UCA36 [mode = degraded, driveDirection = backwards, driveControllerMode = forwards, currentSpeed = trainSpeed, desiredSpeed = greaterZero][H2]   
    } 
}
RL21{
    controlAction: OperatingController.backwards
    type: not-provided
    contexts: {
        UCA37 [mode = normal, driveDirection = backwards, driveControllerMode = forwards, currentSpeed = trainSpeed, desiredSpeed = zero][H2]
        UCA38 [mode = degraded, driveDirection = backwards, driveControllerMode = backwards, currentSpeed = trainSpeed, desiredSpeed = zero][H2]
    } 
}

// SendMessage (to Other Vehicle)
RL22{
    controlAction: OperatingController.sendMessage
    type: not-provided
    contexts: {
        UCA39 [safeDocking = on][H3,H4,H6]
    } 
}


// Operating controller communicating with navigation
RL23{
    controlAction: OperatingController.getDesiredSpeed
    type: not-provided
    contexts:{
        UCA40 [mode = normal] [H6]
        UCA41 [mode = degraded] [H6]
        UCA42 [mode = emergency] [H6]
        UCA43 [remote_control = on] [H6]
    }
}
RL24{
    controlAction: OperatingController.getTrackposition
    type: not-provided
    contexts:{
        UCA44 [mode = normal] [H6]
        UCA45 [mode = degraded] [H6]
        UCA46 [remote_control = on] [H6]
    }
}
//safe docking
RL25{
    controlAction: ManagementSystem.safeDocking
    type: not-provided
    contexts:{
