RL1{
    controlAction:ManagementSystem.safeDocking1
    type: not-provided
    contexts: {
       UCA1 [safeDockingNeeded = Yes, trainOK = Yes] [H4]
    }
}
RL2{
    controlAction:ManagementSystem.safeDocking1
    type: provided
    contexts: {
        UCA2 [safeDockingNeeded = No][H4]
        UCA3 [trainOK = No] [H5]
    }
}
