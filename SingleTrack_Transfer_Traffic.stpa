/* 
This STPA will only focus on the case, when the train is notified to perform a safe docking procedure and
therefore the Operating Controller is in 'SafeDocking' mode. Everything else is described in the main STPA.

Safedocking:
 1. Management System notifies both trains, giving both trains the meanst to communicate
 2. Both trains confirm the command, switch into safe docking mode and establish a connection to communicate
 3. Both trains regularly send their track kilometer (Based on distance, the speed is defined)
 4. If trains come to close for accurate positioning, distance sensors will detect the distance between both, 
    steadily decreasing speed until both stop at the same point and make contact
 5. Upon contact, docking sensors give out the signal, that the maneuver was successful and both trains switch their destinations.

If in any case a train switches into emergency mode the Management System is informed and the maneuver aborted

If a train is beeing controlled remotly
*/

Losses
L1 "Loss of life or injury"
L2 "Loss of damage to operating components, vehicles or infrastructure"
L3 "Loss of Communication"
L4 "Loss of mission"
L5 "Loss of customer satisfaction"

Hazards
H1 "Vehicle loses communication to other vehicle during safe-docking-procedure" [L3]
H2 "Vehicles dock with too much speed against each other" [L1,L2,L3,L4,L5]
H3 "Vehicle thinks it docked succesfully, while not being docked" [L1, L5]
H4 "Vehicles are not informed correctly that they need to dock" [L1]
H5 "One or both trains are unable to perform the maneuver"[L1]
H6 "Vehicles calculate incorrect distances between each other"[L1,L2]

SystemConstraints
SC1 "The trains must not lose communication to each other during the safe-docking-procedure"[H1]
SC2 "The vehicles must dock slowly against each other without damaging components or risk passangers" [H2]
SC3 "Vehicles must be able to confirm, when the maneuver has been succesfull"[H3]
SC4 "The correct vehicles must be informed in time for a full maneuver without risking any hazards"[H4]
SC5 "Both trains must be able to perform the maneuver. Otherwise it needs to be aborted"[H5]
SC6 "The trains must always know the correct distance between each other"[H6] 



ControlStructure
Structure{
    RemoteController{
        processModel{
            gpsPosition: [GPS]
            currentSpeed: [trainSpeed]
            driveControllerMode: [emergencyStop=[1], forwards=[2], backwards=[3]]
        }
        controlActions{
            [takeControl "takeControl", releaseControl "releaseControl", setSpeed "setSpeed", setMode "setMode"] -> OperatingController
            [takeControl2 "takeControl", releaseControl2 "releaseControl", setSpeed2 "setSpeed", setMode2 "setMode"] -> OperatingController2
        }
    }
    ManagementSystem{
        processModel{
            safeDockingNeeded: [Yes = [true], No = [false]]
            trainJobListEmpty: [Yes = [true], No = [false]]
            availableJobs: [Yes = [true], No = [false]]
            trainOK: [Yes = [true], No = [false]]
            abortingNotified: [Yes = [true], No = [false]]
        }
        controlActions{
            [safeDocking1 "safedocking", abort1 "abortSafedocking"] -> Train_1
            [safeDocking2 "safedocking", abort2 "abortSafedocking"] -> Train_2
        }
    }

    Train_1{
        OperatingController{
            processModel{
                remote_control: [on=[true],off=[false]]
                mode: [initialization=[0],normal=[1], degraded = [2],emergency= [4]]
                safeDocking: [on = [true], off = [false]]
                driveControllerMode: [emergencyStop=[1], forwards=[2], backwards=[3]]
                gpsPosition: [GPS]
                trackPosition: [trackkilometer]
                desiredSpeed: [desiredSpeed]
                driveDirection: [forwards=[2], backwards=[3]]
                currentSpeed: [trainSpeed=[desiredSpeed], lessDesiredSpeed = [MIN, desiredSpeed), greaterDesiredSpeed=(desiredSpeed, MAX]]
                destinationList: [destination]
                distanceToDestination: [smallerOneKM = (MIN,1], greaterOneKM = [1, MAX]]
                distanceToVehicle: [greater500m = (500,MAX],  smaller500m = (10,500], smaller10m = [MIN,10]]

            }
            controlActions{
                //  [setMode "setMode", setSpeed "setSpeed", setDirection "setDirection"] -> DriveController
                // set Speed
               [setSpeed "setSpeed"] -> DriveController
               // set Mode
               //[emergencyStop "emergencyStop", forwards "forwards", backwards "backwards"] -> DriveController
               [sendLocation "Location", sendAbort "Abort", sendMessage "Message"] -> Train_2
               [sendLocationTrack "Location", sendDestination "Destination"] -> TrackNavigation
               [OtherCA "OtherControlActions"] -> OtherSubSystems

            }
            feedback{
                [TrainSpeed "trainspeed", location1 "gpsLocation", remoteConf "remoteConfirmation", driveMode "driveMode"] -> RemoteController
                [location2 "gpsLocation", destConf "destinationConfirmation", arrConf "arrivalConfirmation", safeDockingConf "safeDockingConfirmation", safedockingAbort "abort"] -> ManagementSystem
            }
        }
        TrackNavigation{
            processModel{
                gpsPosition: [GPS]
                Track: [Trackkilometers]
                Destination:[Destination]
            }
            feedback{
            [driveDirection "Direction", trackPosition "trackPosition"] -> OperatingController
            }
        }
        DriveController{
            feedback{
                [driving_mode "currentMode", desiredSpeed "desiredSpeed", direction "direction"] -> OperatingController
            }
        }
        OtherSubSystems{
            feedback{
                [Otherfeedback "Otherfeedback"] -> OperatingController
            }
        }
        PhysicalUnits{
            DistanceSensors{
                feedback{
                    [distanceToVehicle "distanceToVehicle"] -> OperatingController
                }
            }
            DockingSensors{
                feedback{
                    [DockingContract "DockingContract"] -> OperatingController
                }
            }
            OtherUnits{}
        }
    }

    Train_2{
        OperatingController2{
            processModel{
                remote_control: [on=[true],off=[false]]
                mode: [initialization=[0],normal=[1], degraded = [2],emergency= [4]]
                safeDocking: [on = [true], off = [false]]
                driveControllerMode: [emergencyStop=[1], forwards=[2], backwards=[3]]
                gpsPosition: [GPS]
                trackPosition: [trackkilometer]
                desiredSpeed: [desiredSpeed]
                driveDirection: [forwards=[2], backwards=[3]]
                currentSpeed: [trainSpeed=[desiredSpeed], lessDesiredSpeed = [MIN, desiredSpeed), greaterDesiredSpeed=(desiredSpeed, MAX]]
                destinationList: [destination]
                distanceToDestination: [smallerOneKM = (MIN,1], greaterOneKM = [1, MAX]]
                distanceToVehicle: [greater500m = (500,MAX],  smaller500m = (10,500], smaller10m = [MIN,10]]

                
            }
            controlActions{
                //  [setMode "setMode", setSpeed "setSpeed", setDirection "setDirection"] -> DriveController
                // set Speed
               [setSpeed "setSpeed"] -> DriveController2
               // set Mode
               //[emergencyStop "emergencyStop", forwards "forwards", backwards "backwards"] -> DriveController
               [sendLocation "location", sendAbort "Abort", sendMessage "Message"] -> Train_1
               [sendLocationTrack "Location", sendDestination "Destination"] -> TrackNavigation2
               //[OtherCA "OtherControlActions"] -> OtherSubSystems

            }
            feedback{
                [TrainSpeed "trainspeed", location1 "gpsLocation", remoteConf "remoteConfirmation", driveMode "driveMode"] -> RemoteController
                [location2 "gpsLocation", destConf "destinationConfirmation", arrConf "arrivalConfirmation", safeDockingConf "safeDockingConfirmation", safedockingAbort "abort"] -> ManagementSystem
            }
        }
        TrackNavigation2{
            processModel{
                gpsPosition: [GPS]
                Track: [Trackkilometers]
                Destination:[Destination]
            }
            feedback{
            [driveDirection "Direction", trackPosition "trackPosition"] -> OperatingController2
            }
        }
        DriveController2{
            feedback{
                [driving_mode "currentMode", desiredSpeed "desiredSpeed", direction "direction"] -> OperatingController2
            }
        }
        OtherSubSystems2{
            feedback{
                [Otherfeedback "Otherfeedback"] -> OperatingController2
            }
        }
        PhysicalUnits2{
            DistanceSensors2{
                feedback{
                    [distanceToVehicle "distanceToVehicle"] -> OperatingController
                }
            }
            DockingSensors2{
                feedback{
                    [DockingContract "DockingContract"] -> OperatingController
                }
            }
            OtherUnits2{}
        }
    }
}

Responsibilities
ManagementSystem{
    R1 "Inform the right controllers at the right time about the maneuver"[SC4]
    R2 "Abort the maneuver in case a train notfies an emergency or is in other ways unable to perform it"[SC5]
}
OperatingController{
    R3 "Sustain communication at all times with the other vehicle and immidiatly notify the Management System if the connection brakes"[SC1]
    R4 "Have an adequate speed, when docking to the other vehicle as to not risk loss"[SC2]
    R5 "Immediatly abort in case of emergency or if it is in any other way unable to perform it"[SC5]
    R6 "Reduce speed, if distance to vehicle is low enough during safedocking mode" [SC2]
    R7 "Abort, when being remotly controlled"[SC5]
}

TrackNavigation{
    R8 "Always give the train the correct positional awareness on the track"[SC6]
    }
DockingSensors{
    R9 "Confrim if the vehicles have docked together"[SC3]
    R10 "Confirm that docing was at a safe pace, without damaging to vehicles"[SC2]
}
DistanceSensors{
    R11 "Give the correct distance between vehicles, when they are close enough to measure"[SC6]
}
OperatingController2{
    R12 "Sustain communication at all times with the other vehicle and immidiatly notify the Management System if the connection brakes"[SC1]
    R13 "Have an adequate speed, when docking to the other vehicle as to not risk loss"[SC2]
    R14 "Immediatly abort in case of emergency or if it is in any other way unable to perform it"[SC5]
    R15 "Reduce speed, if distance to vehicle is low enough during safedocking mode" [SC2]
    R16 "Abort, when being remotly controlled"[SC5]
}

TrackNavigation2{
    R17 "Always give the train the correct positional awareness on the track"[SC6]
    }
DockingSensors2{
    R18 "Confrim if the vehicles have docked together"[SC3]
    R19 "Confirm that docing was at a safe pace, without damaging to vehicles"[SC2]
}
DistanceSensors2{
    R20 "Give the correct distance between vehicles, when they are close enough to measure"[SC6]
}

